# Copy to backend/.env and fill in for local development. Never commit backend/.env.
# Production values are set in Coolify (Backend > Environment Variables).

MONGO_URI=mongodb://127.0.0.1:27017/arcrm
JWT_SECRET=
JWT_EXPIRATION_TIME=
PORT=4003
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email: MSG91 and/or SMTP
EMAIL_PROVIDER=
MSG91_AUTHKEY=
MSG91_DOMAIN=
MSG91_FROM_EMAIL=
MSG91_FROM_NAME=
MSG91_TEMPLATE_ID=
MSG91_COMPANY_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# File storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
